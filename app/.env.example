# Backend API base URL.
#
# Options:
# 1. For iOS Simulator / Android Emulator on the same machine:
#    EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# 2. For physical devices running Expo Go on the local network:
#    EXPO_PUBLIC_API_URL=http://192.168.X.X:8000/api/v1
#    (Replace 192.168.X.X with your host computer's local LAN IP address)
#    NOTE: The backend FastAPI server must be run with `--host 0.0.0.0`
#    to accept incoming connections from other devices on the network.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
