# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sahoolat_user:sahoolat_pass@localhost:5432/sahoolat_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_before_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development    # development | production
DEBUG=true             # When true, OTP is returned in API response (dev only)
ALLOWED_ORIGINS_STR=http://localhost:8081,http://localhost:3000

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
# TODO: Add real SMS gateway credentials here (e.g. Twilio) when ready
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
