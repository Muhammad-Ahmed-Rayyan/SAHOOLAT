# ─── Database (Hosted on Neon Lakebase Postgres) ──────────────────────────────
#
# Obtain your connection strings by linking to the shared project via the Neon CLI:
#   1. npx neon@latest auth
#   2. npx neon@latest link --project-id curly-violet-39400232 --org-id org-lively-forest-89506850
#   3. npx neon@latest env pull
# (Or ask a team member to invite your account to the Neon organization)
#
# Pooled connection string (with -pooler) used for FastAPI runtime:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct unpooled connection string (without -pooler) used by Alembic migrations:
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Generate your own unique secret key for local development. DO NOT reuse this placeholder value.
# Command to generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_your_own_secret_key_here_do_not_use_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ─── Application Settings ──────────────────────────────────────────────────────
APP_ENV=development  # development | production
DEBUG=true           # When true, dev OTP is returned in the API response
ENABLE_DEMO_SIMULATION=true  # When true, allows /insurance/simulate-weather endpoint for testing

# Comma-separated list of allowed origins for CORS (parsed by config.py validator)
ALLOWED_ORIGINS_STR=http://localhost:8081,http://localhost:3000

# ─── OTP Settings ──────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
