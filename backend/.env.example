# ─── Database (Neon Lakebase Postgres) ─────────────────────────────────────────
# Pooled URL for application runtime:
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) URL for Alembic migrations:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_before_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development    # development | production
DEBUG=true             # When true, OTP is returned in API response (dev only)
ALLOWED_ORIGINS_STR=http://localhost:8081,http://localhost:3000

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
# TODO: Add real SMS gateway credentials here (e.g. Twilio) when ready
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
